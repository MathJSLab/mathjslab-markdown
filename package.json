{
  "name": "mathjslab-markdown",
  "version": "0.9.2",
  "description": "Reusable Markdown engine, educational extensions and document Web Component.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/types/markdown-core.d.ts",
      "import": "./dist/source/markdown-core.js",
      "default": "./dist/source/markdown-core.js"
    },
    "./component": {
      "types": "./dist/types/markdown-component.d.ts",
      "import": "./dist/source/markdown-component.js",
      "default": "./dist/source/markdown-component.js"
    },
    "./component/register": {
      "types": "./dist/types/markdown-component-register.d.ts",
      "import": "./dist/source/markdown-component-register.js",
      "default": "./dist/source/markdown-component-register.js"
    },
    "./extensions": {
      "types": "./dist/types/markdown-extensions.d.ts",
      "import": "./dist/source/markdown-extensions.js",
      "default": "./dist/source/markdown-extensions.js"
    },
    "./mathjslab": {
      "types": "./dist/types/markdown-mathjslab.d.ts",
      "import": "./dist/source/markdown-mathjslab.js",
      "default": "./dist/source/markdown-mathjslab.js"
    },
    "./mathjslab/worker": {
      "types": "./dist/types/markdown-mathjslab-worker.d.ts",
      "import": "./dist/source/markdown-mathjslab-worker.js",
      "default": "./dist/source/markdown-mathjslab-worker.js"
    },
    "./browser": {
      "types": "./dist/types/markdown-document.d.ts",
      "import": "./dist/source/markdown-document.js",
      "default": "./dist/source/markdown-document.js"
    },
    "./compat/*": {
      "types": "./dist/types/*.d.ts",
      "import": "./dist/source/*.js",
      "default": "./dist/source/*.js"
    },
    "./bundles/*": "./dist/browser/*",
    "./hdl": {
      "types": "./dist/types/markdown-hdl.d.ts",
      "import": "./dist/source/markdown-hdl.js",
      "default": "./dist/source/markdown-hdl.js"
    },
    "./hdl/node": {
      "types": "./dist/types/markdown-hdl-node.d.ts",
      "import": "./dist/source/markdown-hdl-node.js",
      "default": "./dist/source/markdown-hdl-node.js"
    },
    "./hdl/assets/*": "./dist/browser/hdl/*"
  },
  "types": "./dist/types/markdown-core.d.ts",
  "files": [
    "dist/",
    "example/",
    "script/hdl/ghdl-synth/",
    "script/hdl/nvc-browser/",
    "script/hdl/icarus-browser/",
    "script/3dmol/",
    "doc/hdl-vhdl-progress.md",
    "doc/hdl-browser-results.md",
    "doc/hdl-github-actions.md",
    "doc/extensions/hdl-troubleshooting.md",
    "doc/integration/MarkdownHDLConfiguration.ts",
    "doc/integration/mathjslab-app-empty-trace.patch",
    "CHANGES.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "sideEffects": [
    "./dist/source/markdown-component-register.js",
    "./dist/source/markdown-document.js"
  ],
  "scripts": {
    "clean:package-lock": "node script/helper/clean-package-lock.cjs",
    "clean:build": "node script/helper/project-tasks.mjs clean-build",
    "clean:repository": "node script/helper/project-tasks.mjs clean-repository",
    "clean:results": "node script/helper/project-tasks.mjs clean-results",
    "clean": "npm run clean:build && npm run clean:results",
    "clean:all": "npm run clean && npm run clean:repository && npm run clean:package-lock",
    "clone:repository": "node script/helper/project-tasks.mjs clone",
    "copy:repository": "node script/helper/project-tasks.mjs copy",
    "clone:copy:clean:repository": "npm run clone:repository && npm run copy:repository && npm run clean:repository",
    "install:approve:all": "npm install-scripts approve --all && npm install",
    "install:all": "npm install && npm run clone:copy:clean:repository",
    "update": "npm run deps:update",
    "tsx": "tsx",
    "npx:tsx": "npx tsx",
    "crono:start": "npm run tsx -- script/helper/mark-crono.ts start",
    "crono:mark": "npm run tsx -- script/helper/mark-crono.ts mark",
    "crono:stop": "npm run tsx -- script/helper/mark-crono.ts stop",
    "format": "prettier --write .",
    "lint": "eslint src",
    "format:lint": "npm run format && npm run lint",
    "prepare:3dmol": "node script/3dmol/prepare.mjs",
    "build:types": "npm run prepare:3dmol && tsc -p tsconfig.build.json",
    "build:package": "npm run prepare:3dmol && node script/verify-hdl-assets.mjs && tsx ./node_modules/webpack/bin/webpack --config webpack.config.ts",
    "build:browser": "npm run build:package -- --mode production",
    "build:dev": "npm run build:types && npm run build:package -- --mode development",
    "build:prod": "npm run clean:build && npm run build:types && npm run build:browser",
    "build": "npm run build:prod",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "pretest:unit": "npm run prepare:3dmol",
    "test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.cjs --runInBand",
    "test": "npm run test:unit",
    "test:distribution": "node --test test/distribution/*.test.mjs",
    "test:browser:fragments": "node test/browser/fragments.mjs",
    "test:browser:molecules": "node test/browser/molecules.mjs",
    "test:browser:example-references": "node test/browser/example-references.mjs",
    "verify:package": "node script/verify-package.mjs",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts",
    "prepack": "npm run build && npm run verify:distribution",
    "prepublishOnly": "npm run release:check",
    "do:all": "npm run release:prepare",
    "git:add": "git add .",
    "git:commit": "node script/helper/git-commit.cjs",
    "git:push": "git push --set-upstream origin main",
    "git:all": "npm run git:add && npm run git:commit && npm run git:push",
    "git:publish:example": "git add -- example/ && git commit --only -m \"docs: update examples\" -- example/ && git push origin HEAD",
    "npm:publish": "npm publish",
    "build:script": "tsc -p script/tsconfig.json",
    "prebuild": "npm run build:script",
    "test:hdl:real": "npm run build:types && node --test --test-timeout=120000 test/hdl/*.test.mjs",
    "serve:hdl": "npm run build:types && node script/serve-hdl.mjs",
    "prepare:hdl:tools": "node script/prepare-hdl-tools.mjs",
    "verify:hdl:assets": "node script/verify-hdl-assets.mjs",
    "test:hdl:browser": "node test/hdl-browser/run.mjs",
    "test:hdl:browser:presentation": "node test/hdl-browser/presentation.mjs",
    "test:hdl:browser:vhdl": "node test/hdl-browser/vhdl-synthesis.mjs",
    "test:hdl:browser:vhdl:runtime": "node test/hdl-browser/vhdl-runtime.mjs",
    "test:hdl:browser:verilog:runtime": "node test/hdl-browser/verilog-runtime.mjs",
    "verify:hdl:release": "node script/verify-hdl-release.mjs",
    "test:hdl:ci": "node --test test/hdl-ci/*.test.mjs",
    "hdl:ci:help": "node script/hdl/github-actions.mjs help",
    "hdl:ci:branch": "node script/hdl/github-actions.mjs branch",
    "hdl:ci:push": "node script/hdl/github-actions.mjs push",
    "hdl:ci:status": "node script/hdl/github-actions.mjs status",
    "hdl:ci:download": "node script/hdl/github-actions.mjs download",
    "deps:check": "ncu --target latest --dep prod,dev,optional,peer",
    "deps:update": "npm run deps:check -- --upgrade && npm install && npm update",
    "repo:sync": "npm run clone:copy:clean:repository",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:hdl:ci",
    "verify:distribution": "npm run test:distribution && npm run verify:package",
    "test:browser:structured-blocks": "node test/browser/structured-blocks.mjs",
    "test:browser": "npm run test:browser:fragments && npm run test:browser:example-references && npm run test:browser:structured-blocks && npm run test:browser:molecules",
    "release:check": "npm run verify:hdl:release && npm run check",
    "release:prepare": "npm run release:check && npm pack",
    "release:validate": "npm run release:prepare && npm run test:browser && npm run test:hdl:browser",
    "release:publish": "npm publish"
  },
  "dependencies": {
    "@mathjax/mathjax-newcm-font": "^4.1.3",
    "dompurify": "3.4.17",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.2",
    "marked-gfm-heading-id": "^4.1.4",
    "marked-highlight": "^2.2.4"
  },
  "optionalDependencies": {
    "@citation-js/core": "0.9.0",
    "@citation-js/plugin-bibtex": "0.9.0",
    "@citation-js/plugin-csl": "0.9.0",
    "@mathjax/mathjax-mhchem-font-extension": "^4.1.3",
    "@rod2ik/tikzjax": "1.6.0",
    "@viz-js/viz": "3.31.0",
    "3dmol": "2.5.5",
    "abcjs": "6.7.2",
    "citeproc": "2.4.63",
    "json5": "2.2.3",
    "jsxgraph": "1.14.2",
    "leaflet": "1.9.4",
    "mathjax": "^4.1.3",
    "mermaid": "^12.2.0",
    "netlistsvg": "1.0.2",
    "smiles-drawer": "^2.4.1",
    "three": "0.186.1",
    "topojson-client": "3.1.0",
    "vega": "6.4.0",
    "vega-embed": "7.3.0",
    "vega-lite": "6.5.0",
    "verovio": "6.3.0",
    "wavedrom": "3.8.0"
  },
  "peerDependencies": {
    "mathjslab": "^2.9.0"
  },
  "peerDependenciesMeta": {
    "mathjslab": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "@types/webpack": "^5.28.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "mathjslab": "2.9.0",
    "minimizer-webpack-plugin": "5.13.1",
    "npm-check-updates": "^23.1.1",
    "playwright-core": "1.64.1",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3"
  },
  "keywords": [
    "MathJSLab",
    "markdown",
    "web-component",
    "education",
    "mathematics",
    "gfm",
    "mathjax",
    "mermaid",
    "worker"
  ],
  "homepage": "https://mathjslab.com/",
  "bugs": {
    "url": "https://github.com/MathJSLab/mathjslab-markdown/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MathJSLab/mathjslab-markdown.git"
  },
  "author": "Sergio Lindau <sergiolindau@gmail.com>",
  "main": "./dist/source/markdown-core.js",
  "module": "./dist/source/markdown-core.js",
  "engines": {
    "node": "^22.13.0 || >=24",
    "npm": ">=10"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "allowScripts": {
    "esbuild": true,
    "unrs-resolver": true,
    "@parcel/watcher": true
  },
  "overrides": {
    "netlistsvg": {
      "json5": "$json5",
      "yargs": "^17.7.2"
    }
  }
}
